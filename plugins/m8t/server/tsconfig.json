{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@m8t-stack/agent-ledger": ["../../../packages/agent-ledger/dist/esm/index.d.ts"],
      "@m8t-stack/api-contract": ["../../../packages/api-contract/dist/esm/index.d.ts"],
      "@m8t-stack/foundry-invoke": ["../../../packages/foundry-invoke/dist/esm/index.d.ts"],
      "@m8t-stack/github-app-auth": ["../../../packages/github-app-auth/dist/esm/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
